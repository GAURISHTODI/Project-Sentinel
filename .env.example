# Copy to .env (gitignored) and fill in. Never commit real values.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=sentinel
REDIS_PASSWORD=change-me-locally

# Host ports (bound to 127.0.0.1 only)
KAFKA_EXTERNAL_PORT=29092
REDIS_PORT=6379
POSTGRES_PORT=5432

# Python services (host side)
KAFKA_BOOTSTRAP=127.0.0.1:29092
EVENTS_TOPIC=events.normalized
REDIS_URL=redis://:change-me-locally@127.0.0.1:6379/0
DATABASE_URL=postgresql://sentinel:change-me-locally@127.0.0.1:5432/sentinel?sslmode=verify-full&sslrootcert=infra/tls/ca.crt

# viz profile only
SPLUNK_PASSWORD=change-me-locally
SPLUNK_HEC_TOKEN=change-me-locally
SPLUNK_HEC_URL=https://127.0.0.1:8088/services/collector/event
GRAFANA_ADMIN_PASSWORD=change-me-locally

# API auth: generate with `python -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET=
JWT_TTL_MINUTES=30

# Notifications (leave blank to log only)
WEBHOOK_URL=
WEBHOOK_FLAVOR=slack

# LLM triage (Phase 5): provider = mock | gemini | anthropic | azure
LLM_PROVIDER=mock
LLM_API_KEY=

# Least-privilege DB logins (scripts/db_roles.sh): set real values in .env only.
DB_DETECT_PASSWORD=change-me-locally
DB_API_PASSWORD=change-me-locally
DB_READER_PASSWORD=change-me-locally
