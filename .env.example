# Copy to .env (gitignored) and fill in. Never commit real values.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=sentinel
REDIS_PASSWORD=change-me-locally

# Host ports (bound to 127.0.0.1 only)
KAFKA_EXTERNAL_PORT=29092
REDIS_PORT=6379
POSTGRES_PORT=5432

# Python services (host side)
KAFKA_BOOTSTRAP=localhost:29092
EVENTS_TOPIC=events.normalized
REDIS_URL=redis://:change-me-locally@localhost:6379/0
DATABASE_URL=postgresql://sentinel:change-me-locally@localhost:5432/sentinel

# viz profile only
SPLUNK_PASSWORD=change-me-locally
SPLUNK_HEC_TOKEN=change-me-locally
GRAFANA_ADMIN_PASSWORD=change-me-locally

# LLM triage (Phase 5): provider = mock | gemini | anthropic | azure
LLM_PROVIDER=mock
LLM_API_KEY=
